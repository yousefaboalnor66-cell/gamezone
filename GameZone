}

.modal p{
    color:#aaa;
    line-height:1.9;
    margin:10px 0;
}

.modal-rating{
    color:#ffd43b;
    font-size:20px;
}

.buttons{
    display:flex;
    gap:10px;
    margin-top:25px;
}

.download{
    flex:1;
    border:0;
    border-radius:10px;
    padding:14px;
    background:linear-gradient(135deg,#16a34a,#22c55e);
    color:white;
    font-weight:bold;
    cursor:pointer;
}

.close-btn{
    flex:1;
    border:0;
    border-radius:10px;
    padding:14px;
    background:#27273b;
    color:white;
    cursor:pointer;
}

/* EMPTY */

.empty{
    display:none;
    text-align:center;
    padding:40px;
    color:#888;
}

/* FOOTER */

footer{
