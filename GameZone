    color:#ccc;
    border-radius:25px;
    cursor:pointer;
}

.filter:hover{
    background:#7c3aed;
    color:white;
}

/* MODAL */

.modal{
    display:none;
    position:fixed;
    inset:0;
    background:rgba(0,0,0,.85);
    z-index:200;
    align-items:center;
    justify-content:center;
