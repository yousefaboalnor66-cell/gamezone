const games = document.querySelectorAll(".game");

const search = document.getElementById("search");

const empty = document.getElementById("empty");

const modal = document.getElementById("modal");

let selectedGame = null;


/* فتح تفاصيل اللعبة */

function openGame(game){

    selectedGame = game;

    document.getElementById("modalTitle").textContent =
        game.dataset.name;

    document.getElementById("modalRating").textContent =
        "★ " + game.dataset.rating;

    document.getElementById("modalPlatform").textContent =
        "🎮 المنصة: " + game.dataset.platform;

    document.getElementById("modalDescription").textContent =
        game.dataset.description;

    modal.style.display = "flex";
}


/* إغلاق */

function closeGame(){

    modal.style.display = "none";

}


/* الضغط خارج النافذة */

modal.addEventListener("click",function(e){

    if(e.target === modal){
        closeGame();
    }

});


/* البحث */

search.addEventListener("input",function(){

    const value =
        this.value.toLowerCase().trim();

    let found = 0;

    games.forEach(function(game){

        const name =
            game.dataset.name.toLowerCase();

        const platform =
            game.dataset.platform.toLowerCase();

        if(
            name.includes(value) ||
            platform.includes(value)
        ){

            game.style.display = "block";
            found++;

        }else{

            game.style.display = "none";

        }

    });

    empty.style.display =
        found === 0 ? "block" : "none";

});


/* فلترة المنصة */

function filterGames(platform){

    search.value = "";

    let found = 0;

    games.forEach(function(game){

        if(
            platform === "all" ||
            game.dataset.platform === platform
        ){

            game.style.display = "block";
            found++;

        }else{

            game.style.display = "none";

        }

    });

    empty.style.display =
        found === 0 ? "block" : "none";

    document
        .getElementById("games")
        .scrollIntoView({
            behavior:"smooth"
        });

}


/* عرض الكل */

function showAll(){

    search.value = "";

    games.forEach(function(game){

        game.style.display = "block";

    });

    empty.style.display = "none";

}


/* زر التنزيل */

function downloadGame(){

    if(!selectedGame){
        return;
    }

    const name =
        selectedGame.dataset.name;

    /*
      هنا يتم توجيه المستخدم للبحث عن
      المتجر/المصدر الرسمي للعبة.
    */

    const officialSearch =
        "https://www.google.com/search?q=" +
        encodeURIComponent(
            name + " official download"
        );

    window.open(
        officialSearch,
        "_blank"
    );

}


/* زر ESC */

document.addEventListener("keydown",function(e){

    if(e.key === "Escape"){
        closeGame();
    }

});

