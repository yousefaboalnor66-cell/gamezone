.modal-box{
    width:100%;
    max-width:550px;
    background:#10101c;
    border:1px solid #8b5cf6;
    border-radius:20px;
    padding:28px;
    position:relative;
}

.close{
    position:absolute;
    top:12px;
    left:18px;
    font-size:30px;
    color:#999;
    cursor:pointer;
}

.close:hover{
    color:white;
}

.modal h2{
    color:#c084fc;
    margin:15px 0;
