    padding:45px 20px;
    border-top:1px solid #242438;
    color:#777;
}

footer strong{
    color:#a855f7;
}

/* MOBILE */

@media(max-width:1000px){

    .games{
        grid-template-columns:repeat(3,1fr);
    }

}

@media(max-width:750px){

    nav{
