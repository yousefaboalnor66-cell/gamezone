    }

    .hero h1{
        font-size:43px;
    }

    .games{
        grid-template-columns:repeat(2,1fr);
        gap:12px;
    }

    .cover{
        height:160px;
        font-size:19px;
    }

}

@media(max-width:450px){

    .games{
        grid-template-columns:1fr 1fr;
    }

    .game-info{
        padding:11px;
    }

    .game-info h3{
        font-size:15px;
    }

    .buttons{
        flex-direction:column;
    }

}

