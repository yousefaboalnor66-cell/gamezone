<script>

/* ================= SLIDER ================= */

let currentSlide = 0;

const slides =
document.querySelectorAll(".slide");

const dots =
document.querySelectorAll(".dot");


function showSlide(index){

    currentSlide = index;

    slides.forEach(
        (slide,i)=>{
            slide.classList.toggle(
                "active",
                i === index
            );
        }
    );

    dots.forEach(
        (dot,i)=>{
            dot.classList.toggle(
                "active",
                i === index
            );
        }
    );

}


setInterval(
    ()=>{
        currentSlide =
        (currentSlide + 1)
        % slides.length;

        showSlide(currentSlide);

    },
    5000
);


/* ================= SCROLL ================= */

function go(id){

    document
    .getElementById(id)
    .scrollIntoView({
        behavior:"smooth"
    });

}


/* ================= PHONE SEARCH ================= */

const phoneSearch =
document.getElementById("phoneSearch");

const phoneCards =
document.querySelectorAll("#phoneCards .card");


phoneSearch.addEventListener(
    "input",
    function(){

        const value =
        this.value
        .toLowerCase()
        .trim();

        phoneCards.forEach(
            card=>{

                const name =
                card.dataset.name
                .toLowerCase();

                card.style.display =
                name.includes(value)
                ? "block"
                : "none";

            }
        );

    }
);


/* ================= SELECT PHONE ================= */

function selectPhone(name){

    alert(
        "اخترت: " + name +
        "\nقريبًا هنضيف نظام الترشيح الكامل."
    );

}


/* ================= COMPARE ================= */

function comparePhones(){

    const p1 =
    document.getElementById("phone1").value;

    const p2 =
    document.getElementById("phone2").value;

    const result =
    document.getElementById("compareResult");


    if(p1 === p2){

        result.style.display = "block";

        result.innerHTML =
        "⚠️ اختار موبايلين مختلفين للمقارنة.";

        return;

    }


    result.style.display = "block";


    result.innerHTML =

    "📱 <b>" + p1 + "</b>" +
    "<br>⚡ أداء قوي" +
    "<br><br>" +

    "📱 <b>" + p2 + "</b>" +
    "<br>⚡ أداء قوي" +
    "<br><br>" +

    "🏆 المقارنة التفصيلية هنضيفها في المرحلة القادمة.";

}


/* ================= ESC ================= */

document.addEventListener(
    "keydown",
    function(e){

        if(e.key === "Escape"){
            window.scrollTo({
                top:0,
                behavior:"smooth"
            });
        }

    }
);

</script>

