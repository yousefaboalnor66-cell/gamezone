}

.card-icon{
    height:150px;
    display:flex;
    align-items:center;
    justify-content:center;
    font-size:70px;
    border-radius:13px;
    margin-bottom:15px;
    background:linear-gradient(135deg,#171b30,#2a1742);
}

.card h3{
    margin-bottom:8px;
}

.card p{
    color:#9ca3af;
    line-height:1.7;
}

.rating{
    color:#facc15;
    margin:10px 0;
}

.price{
    color:#a78bfa;
    font-weight:bold;
    margin-bottom:15px;
}

.card button{
    width:100%;
    padding:12px;
    border:0;
    border-radius:10px;
    background:#7c3aed;
    color:white;
    font-weight:bold;
    cursor:pointer;
}

.card button:hover{
    background:#8b5cf6;
}

/* ================= COMPARISON ================= */

.compare{
    max-width:900px;
    margin:auto;
    padding:25px;
    border-radius:20px;
    background:#101321;
    border:1px solid #252a40;
}

.compare-grid{
    display:grid;
    grid-template-columns:1fr 1fr;
    gap:15px;
}

.compare select{
    width:100%;
    padding:13px;
    background:#080b15;
    color:white;
    border:1px solid #30364e;
    border-radius:10px;
}

.compare button{
    margin-top:20px;
    width:100%;
    padding:14px;
    border:0;
    border-radius:10px;
    background:linear-gradient(135deg,#7c3aed,#a855f7);
    color:white;
    font-weight:bold;
    cursor:pointer;
}

.result{
    display:none;
    margin-top:20px;
    padding:20px;
    border-radius:12px;
    background:#171a2b;
    line-height:1.8;
}

/* ================= TRAVEL ================= */

.travel-grid{
    max-width:1200px;
    margin:auto;
    display:grid;
    grid-template-columns:repeat(3,1fr);
    gap:18px;
}

.destination{
    background:#101321;
    border:1px solid #252a40;
    border-radius:18px;
    padding:25px;
}

.destination-icon{
    font-size:60px;
    margin-bottom:15px;
}

.destination h3{
    margin-bottom:8px;
}

.destination p{
    color:#9ca3af;
    line-height:1.7;
}

/* ================= FOOTER ================= */

footer{
