<style>

*{
    box-sizing:border-box;
    margin:0;
    padding:0;
    scroll-behavior:smooth;
}

body{
    font-family:Arial,Tahoma,sans-serif;
    background:#070914;
    color:white;
}

/* ================= HEADER ================= */

header{
    height:72px;
    padding:0 6%;
    display:flex;
    align-items:center;
    justify-content:space-between;
    background:#0b0d1a;
    border-bottom:1px solid #24283b;
    position:sticky;
    top:0;
    z-index:100;
}

.logo{
    font-size:28px;
    font-weight:900;
}

.logo span{
    color:#8b5cf6;
}

nav a{
    color:#ddd;
    text-decoration:none;
    margin-right:22px;
    font-size:15px;
}

nav a:hover{
    color:#a78bfa;
}

/* ================= HERO SLIDER ================= */

.hero{
    padding:25px 5%;
}

.slider{
    position:relative;
    max-width:1250px;
    height:440px;
    margin:auto;
    border-radius:25px;
    overflow:hidden;
    box-shadow:0 20px 70px rgba(0,0,0,.5);
}

.slide{
    position:absolute;
    inset:0;
    opacity:0;
    transform:scale(1.04);
    transition:.7s;
    display:flex;
    align-items:center;
    padding:50px 7%;
}

.slide.active{
    opacity:1;
    transform:scale(1);
}

.travel{
    background:
    radial-gradient(circle at 75% 30%,#38bdf855,transparent 28%),
    linear-gradient(120deg,#071a35,#075985,#10172b);
}

.phone{
    background:
    radial-gradient(circle at 75% 40%,#a855f755,transparent 30%),
    linear-gradient(120deg,#090b17,#291044,#111827);
}

.slide-content{
    max-width:620px;
    z-index:2;
}

.tag{
    display:inline-block;
    padding:8px 15px;
    border-radius:30px;
    background:#ffffff18;
    border:1px solid #ffffff30;
    margin-bottom:18px;
}

.slide h1{
    font-size:48px;
    line-height:1.15;
    margin-bottom:15px;
}

.slide p{
    font-size:18px;
    color:#e5e7eb;
    line-height:1.8;
    margin-bottom:25px;
}

.cta{
    border:0;
    background:white;
    color:#111827;
    padding:14px 25px;
    border-radius:12px;
    font-weight:bold;
    font-size:16px;
    cursor:pointer;
}

.visual{
    position:absolute;
    left:7%;
    font-size:125px;
    filter:drop-shadow(0 20px 30px #0008);
}

.controls{
    position:absolute;
    bottom:20px;
    right:7%;
    display:flex;
    gap:8px;
    z-index:5;
}

.dot{
    width:10px;
    height:10px;
    border:0;
    border-radius:50%;
    background:#ffffff55;
    cursor:pointer;
}

.dot.active{
    width:28px;
    border-radius:10px;
    background:white;
}

/* ================= SECTIONS ================= */

section{
    padding:55px 6%;
}

.title{
    text-align:center;
    margin-bottom:30px;
}

.title h2{
    font-size:32px;
}

.title p{
    color:#9ca3af;
    margin-top:8px;
}

/* ================= CHOICES ================= */

.choices{
    max-width:1100px;
    margin:auto;
    display:grid;
    grid-template-columns:repeat(2,1fr);
    gap:22px;
}

.choice{
    padding:35px;
    border-radius:20px;
    background:#101321;
    border:1px solid #252a40;
    cursor:pointer;
    transition:.25s;
}

.choice:hover{
    transform:translateY(-6px);
    border-color:#8b5cf6;
}

.choice-icon{
    font-size:50px;
    margin-bottom:12px;
}

.choice h3{
    font-size:25px;
    margin-bottom:8px;
}

.choice p{
    color:#9ca3af;
    line-height:1.7;
}

/* ================= SEARCH ================= */

