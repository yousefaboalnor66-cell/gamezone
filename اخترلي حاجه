    margin:0 auto 30px;
}

.search input{
    width:100%;
    padding:16px 20px;
    border-radius:13px;
    border:1px solid #292e45;
    outline:none;
    background:#101321;
    color:white;
    font-size:16px;
}

/* ================= PRODUCTS ================= */

.cards{
    max-width:1200px;
    margin:auto;
    display:grid;
    grid-template-columns:repeat(3,1fr);
    gap:18px;
}

.card{
    background:#101321;
