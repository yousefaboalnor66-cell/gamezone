let currentBannerIndex = 0;
let selectedMobiles = [];

// Initialize
document.addEventListener('DOMContentLoaded', () => {
    renderMobiles(mobiles);
    renderDestinations(destinations);
    startBannerSlider();
});

// Banner slider
function startBannerSlider() {
    setInterval(() => {
        currentBannerIndex = (currentBannerIndex + 1) % 2;
        showBanner(currentBannerIndex);
    }, 5000);
}

function showBanner(index) {
    const banners = document.querySelectorAll('.banner');
    const dots = document.querySelectorAll('.dot');
    
    banners.forEach(banner => banner.classList.remove('active'));
    dots.forEach(dot => dot.classList.remove('active'));
    
    banners[index].classList.add('active');
    dots[index].classList.add('active');
    currentBannerIndex = index;
}

function currentBanner(index) {
    showBanner(index);
}

// Smooth scroll
function scrollTo(selector) {
    const element = document.querySelector(selector);
    if (element) {
        element.scrollIntoView({ behavior: 'smooth' });
    }
}

// Render mobiles
function renderMobiles(items) {
    const grid = document.getElementById('mobilesGrid');
    grid.innerHTML = '';
    
    items.forEach(mobile => {
        const card = document.createElement('div');
        card.className = 'mobile-card';
        card.innerHTML = `
            <div class="card-image">${mobile.emoji}</div>
            <div class="card-content">
                <h3>${mobile.name}</h3>
                <p class="card-specs">${mobile.specs}</p>
                <p class="card-price">${mobile.price}</p>
                <div class="card-features">
                    ${mobile.features.map(f => `<span class="feature-tag">${f}</span>`).join('')}
                </div>
                <button class="btn-select" onclick="selectMobile(${mobile.id}, '${mobile.name}')">اختار</button>
            </div>
        `;
        grid.appendChild(card);
    });
}

// Render destinations
function renderDestinations(items) {
    const grid = document.getElementById('destinationsGrid');
    grid.innerHTML = '';
    
    items.forEach(dest => {
        const card = document.createElement('div');
        card.className = 'destination-card';
        card.innerHTML = `
            <div class="card-image">${dest.emoji}</div>
            <div class="card-content">
                <h3>${dest.name}</h3>
                <p class="card-specs">${dest.description}</p>
                <p class="card-price">${dest.price}</p>
                <div class="card-features">
                    ${dest.features.map(f => `<span class="feature-tag">${f}</span>`).join('')}
                </div>
                <button class="btn-select">اختار الوجهة</button>
            </div>
        `;
        grid.appendChild(card);
    });
}

// Filter mobiles
function filterMobiles() {
    const budget = document.getElementById('budget').value;
    const usage = document.getElementById('usage').value;
    
    let filtered = mobiles;
    
    if (budget) {
        filtered = filtered.filter(m => m.budget === budget);
    }
    
    if (usage) {
        filtered = filtered.filter(m => m.usage.includes(usage));
    }
    
    renderMobiles(filtered);
}

// Filter destinations
function filterDestinations() {
    const budget = document.getElementById('travelBudget').value;
    const days = document.getElementById('days').value;
    const type = document.getElementById('type').value;
    
    let filtered = destinations;
    
    if (budget) {
        filtered = filtered.filter(d => d.budget === budget);
    }
    
    if (days) {
        filtered = filtered.filter(d => d.days === days);
    }
    
    if (type) {
        filtered = filtered.filter(d => d.type === type);
    }
    
    renderDestinations(filtered);
}

